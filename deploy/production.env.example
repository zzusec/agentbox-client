# 生产环境部署参数模板。
#
# 复制为 deploy/production.env 并填入真实值（production.env 已在 .gitignore，
# 不会入库）。发布前先 `source deploy/production.env`，AGENTS.md 的发布命令与
# scripts/enable-domain.sh 都从这些变量取值，避免把服务器地址硬编码进版本库。

# 生产机 SSH 目标（需已配置免密登录）
PROD_SSH=root@your-server-ip
# 生产机上的仓库目录
PROD_DIR=/root/workspace/agentbox
# 对外域名（enable-domain.sh 用作 nginx server_name 与证书域名）
PROD_DOMAIN=agentbox.example.com
# 公网访问地址（发布后验证用）
PROD_URL=https://agentbox.example.com/
# 服务监听地址（config.json 的 listen；enable-domain.sh 回绑用）
PROD_LISTEN=127.0.0.1:8180

# 以下三项用于发布包独立部署布局（deploy/release.py 与 deploy/prod-release.sh）。
# SSH 私钥（留空则用 ssh 默认密钥）
PROD_SSH_KEY=$HOME/.ssh/agentbox_deploy
# 生产机上的程序目录：<PROD_APP>/current -> releases/<版本>
PROD_APP=/opt/agentbox
# 发布包平台后缀，取 build-release.py 的产物名，如 linux_amd64 / linux_arm64
PROD_ARCH=linux_arm64
