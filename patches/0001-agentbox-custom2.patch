+    //
+    // CSI Ps G
+    // Cursor Character Absolute  [column] (default = [row,1]) (CHA).
+    //
+    func cmdCursorCharAbsolute (_ pars: [Int], _ collect: cstring)
+    {
+        let buffer = self.buffer
