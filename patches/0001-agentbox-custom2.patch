+#!/bin/sh
+set -eu
+
+root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+cd "$root"
+
+version=${AGENTBOX_VERSION:-}
+
+swift build -c release
+go build -o "$root/.build/release/abox-sync" ../cmd/abox-sync
+
+app="$root/dist/agentbox-client.app"
