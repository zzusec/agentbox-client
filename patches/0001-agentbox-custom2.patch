+    public func softReset ()
+    {
+        savedAttr = CharData.defaultAttr
+        savedY = 0
+        savedX = 0
+        savedCharset = CharSets.defaultCharset
+        marginRight = cols-1
+        marginLeft = 0
+        savedWraparound = false
