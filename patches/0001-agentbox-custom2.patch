diff --git a/third_party/swiftterm/Sources/SwiftTerm/Mac/MacCaretView.swift b/third_party/swiftterm/Sources/SwiftTerm/Mac/MacCaretView.swift
new file mode 100644
index 0000000..10af181
--- /dev/null
